{
  "icon": "./assets/images/9feae60ea81842259049ab0f27467b93-free-removebg-preview.png",
  "expo": {
    "name": "fireeyes",
    "slug": "fireeyes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/9feae60ea81842259049ab0f27467b93-free-removebg-preview.png",
    "scheme": "fireeyes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devicedrop.fireeyes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/9feae60ea81842259049ab0f27467b93-free-removebg-preview.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/9feae60ea81842259049ab0f27467b93-free-removebg-preview.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e2a430a-83e1-44c9-82ad-22f5a3664010"
      }
    },
    "owner": "devicedrop"
  }
}
